import asyncio
import os
import sqlite3
import tempfile
from contextlib import closing

from aiogram import Bot, Dispatcher, F
from aiogram.filters import CommandStart, Command
from aiogram.types import (
    Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton,
    FSInputFile
)
from edge_tts import Communicate

BOT_TOKEN = os.getenv("BOT_TOKEN")
DB_PATH = os.getenv("DB_PATH", "bot.db")
MAX_CHARS = int(os.getenv("MAX_CHARS", "1500")) # Увеличил лимит символов для тестов

VOICES = {
    "victoria": ("Виктория (RU, жен)", "ru-RU-DariyaNeural"),
    "igor": ("Игорь (RU, муж)", "ru-RU-LevNeural"),
    "maria": ("Мария (RU, жен)", "ru-RU-MashaNeural"),
    "aria": ("Aria (Мультиязычный, жен)", "en-US-AriaNeural"),
    "guy": ("Guy (Мультиязычный, муж)", "en-US-GuyNeural"),
    "sonia": ("Sonia (Мультиязычный, жен, UK)", "en-GB-SoniaNeural"),
}

def db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    with closing(db()) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                voice TEXT NOT NULL DEFAULT 'victoria'
            )
        """)
        conn.commit()

def ensure_user(user_id):
    with closing(db()) as conn:
        conn.execute("INSERT OR IGNORE INTO users(user_id) VALUES(?)", (user_id,))
        conn.commit()

def get_user(user_id):
    ensure_user(user_id)
    with closing(db()) as conn:
        row = conn.execute("SELECT * FROM users WHERE user_id=?", (user_id,)).fetchone()
        return dict(row)

def set_voice(user_id, voice):
    ensure_user(user_id)
    with closing(db()) as conn:
        conn.execute("UPDATE users SET voice=? WHERE user_id=?", (voice, user_id))
        conn.commit()

def voices_kb():
    rows = []
    items = list(VOICES.items())
    for i in range(0, len(items), 2):
        row = []
        for key, (label, _) in items[i:i + 2]:
            row.append(InlineKeyboardButton(text=label, callback_data=f"voice:{key}"))
        rows.append(row)
    return InlineKeyboardMarkup(inline_keyboard=rows)

dp = Dispatcher()

@dp.message(CommandStart())
async def start(message: Message):
    await message.answer(
        "Привет! Я озвучиваю любой текст в аудио. 🎙\n"
        "Пока что всё абсолютно БЕСПЛАТНО и без ограничений!\n\n"
        "Выбери голос кнопкой ниже, а затем просто отправь мне текст.",
        reply_markup=voices_kb()
    )

@dp.message(Command("voices"))
async def voices_cmd(message: Message):
    await message.answer("Выбери голос:", reply_markup=voices_kb())

@dp.callback_query(F.data.startswith("voice:"))
async def cb_voice(cq: CallbackQuery):
    key = cq.data.split(":", 1)[1]
    if key not in VOICES:
        await cq.answer("Неизвестный голос", show_alert=True)
        return
    set_voice(cq.from_user.id, key)
    await cq.message.answer(f"Голос выбран: {VOICES[key][0]}. Теперь отправь текст.")
    await cq.answer()

@dp.message(F.text)
async def handle_text(message: Message):
    text = message.text.strip()
    if text.startswith("/"):
        return
    if len(text) > MAX_CHARS:
        await message.answer(f"Слишком длинный текст. Максимум {MAX_CHARS} символов.")
        return

    u = get_user(message.from_user.id)
    voice_key = u["voice"] if u["voice"] in VOICES else "victoria"
    
    status_msg = await message.answer("Генерирую аудио... ⏳")

    tmp = tempfile.NamedTemporaryFile(suffix=".mp3", delete=False)
    tmp_path = tmp.name
    tmp.close()

    try:
        communicate = Communicate(text, VOICES[voice_key][1])
        await communicate.save(tmp_path)
        
        # Отправляем аудио
        await message.answer_audio(
            FSInputFile(tmp_path),
            caption=f"Голос: {VOICES[voice_key][0]}"
        )
        # Удаляем сообщение "Генерирую аудио..."
        await status_msg.delete()
        
    except Exception as e:
        await message.answer("Ошибка генерации. Попробуй короче текст или позже.")
        print("TTS error:", repr(e))
    finally:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass

async def main():
    if not BOT_TOKEN:
        raise RuntimeError("BOT_TOKEN не задан")
    init_db()
    bot = Bot(BOT_TOKEN)
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
